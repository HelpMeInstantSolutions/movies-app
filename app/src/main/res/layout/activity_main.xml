<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F19">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#131B2E"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cinemas &amp; Shows 🍿"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Watch Blockbuster Movies &amp; Web Series"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_logout"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#EF4444"
            android:contentDescription="Logout" />
    </LinearLayout>

    <!-- Search & Filter Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="#64748B" />

            <EditText
                android:id="@+id/etSearchCourses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search movies, series, or genres..."
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:imeOptions="actionSearch"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Category Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvTabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍿 All Titles"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_tab_active"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvTabPaid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Movies"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_tab_inactive"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvTabFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 Series"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_tab_inactive" />
        </LinearLayout>
    </LinearLayout>

    <!-- Header Section with Title & Count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Featured Catalog"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCourseCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Titles"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_replay_10"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#94A3B8"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- Empty State Layout -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_play_arrow"
            android:tint="#334155" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No titles available yet"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check back soon for new movies and seasons."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Recycler View for Movies & Series -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCourses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutLessonItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_rounded_card">

    <!-- Lesson Index Pill -->
    <TextView
        android:id="@+id/tvLessonNum"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/bg_tab_inactive"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:text="01" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvLessonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Lecture Title" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- Duration Pill -->
            <TextView
                android:id="@+id/tvLessonDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:text="15:00" />

            <TextView
                android:id="@+id/tvLessonBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="• Free Demo" />
        </LinearLayout>
    </LinearLayout>

    <!-- Play Icon with circle -->
    <ImageView
        android:id="@+id/icPlayStatus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_tab_inactive"
        android:padding="8dp"
        android:src="@drawable/ic_play_arrow"
        android:tint="#FFFFFF"
        android:contentDescription="Play" />

</LinearLayout>

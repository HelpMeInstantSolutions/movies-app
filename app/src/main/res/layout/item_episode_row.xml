<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutEpisodeItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_rounded_card">

    <!-- Episode Index Pill -->
    <TextView
        android:id="@+id/tvEpisodeNum"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/bg_tab_inactive"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:text="01" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvEpisodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Episode 1: Pilot" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- Duration Pill -->
            <TextView
                android:id="@+id/tvEpisodeDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:text="45:00" />

            <TextView
                android:id="@+id/tvEpisodeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD STREAM"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_glass_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Play Icon Button -->
    <ImageView
        android:id="@+id/ivEpisodePlay"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_play_arrow"
        android:tint="#F43F5E" />

</LinearLayout>

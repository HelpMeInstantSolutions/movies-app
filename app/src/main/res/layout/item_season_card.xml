<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#131B2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Season Header Row (Clickable to Toggle Expand/Collapse) -->
        <LinearLayout
            android:id="@+id/seasonHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <!-- Season Icon Pill -->
            <RelativeLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_pill"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_folder"
                    android:tint="#F43F5E" />
            </RelativeLayout>

            <!-- Season Title & Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSeasonTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Season 1: Pilot"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSeasonInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10 Episodes • HD 1080p"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Episodes Count Badge -->
            <TextView
                android:id="@+id/tvSeasonEpisodesBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 Episodes"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_glass_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="8dp" />

            <!-- Chevron Icon -->
            <ImageView
                android:id="@+id/ivSeasonChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_expand_more"
                android:tint="#94A3B8" />

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:id="@+id/seasonDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:visibility="gone" />

        <!-- Sub-List for Episodes inside this Season -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSeasonEpisodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
